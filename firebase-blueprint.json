{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SavedService": {
      "title": "SavedService",
      "description": "A service saved by a citizen for quick access",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "savedAt": { "type": "string" }
      },
      "required": ["userId", "serviceId"]
    },
    "ServiceFeedback": {
      "title": "ServiceFeedback",
      "description": "Citizen feedback and ratings for civic services",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceTitle": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "rating"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profile information"
    },
    "/users/{userId}/savedServices/{savedId}": {
      "schema": "SavedService",
      "description": "Stores services bookmarked by the user"
    },
    "/serviceFeedbacks/{feedbackId}": {
      "schema": "ServiceFeedback",
      "description": "Stores user feedback and ratings for services"
    }
  }
}
